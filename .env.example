# Copy to .env and fill in values. Do not commit .env.

# cookiesession1 from the browser (optional)
RRK_COOKIE=

# Date range (Jalali, as used by ocr.rrk.ir)
START_DATE=1360-01-01
END_DATE=1360-12-29

# Phrases to search, separated by |
SEARCH_PHRASES=تست۱|تست۲
# OCR engine: paddleocr | tesseract | easyocr
# paddleocr: better accuracy on scans (Arabic/Persian script)
# tesseract: best for printed Persian newspapers if `fas` traineddata is installed
# easyocr: simple, weaker on old newspaper scans
OCR_ENGINE=paddleocr

# true / false
OCR_USE_GPU=false

# PaddleOCR 3.x language: fa (Persian). Legacy "arabic" is mapped to fa.
OCR_PADDLE_LANG=fa

# Tesseract language codes (needs the Windows/Linux language packs)
OCR_TESSERACT_LANG=fas+ara

IMAGES_DIR=images
RESULT_DIR=result
DOWNLOAD_WORKERS=6
# GPU threads for OCR (only when OCR_USE_GPU=true). 0 = auto (1 for paddle/easyocr).
OCR_GPU_WORKERS=0
# CPU threads for OCR, running in parallel with GPU threads. 0 = auto (2 for paddle/easyocr, 4 for tesseract).
OCR_CPU_WORKERS=0
VERIFY_SSL=false
